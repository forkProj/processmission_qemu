"""Build complete Chinese QEMU documentation without compiling QEMU."""

import argparse
import os
from pathlib import Path
import subprocess
import sys

from check_links import validate_links


def main() -> None:
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument('--jobs', default='2')
    parser.add_argument('--allow-incomplete', action='store_true', help='Local preview only')
    args = parser.parse_args()
    source = Path(__file__).resolve().parents[2]
    output = source / '_build/zh'
    if not args.allow_incomplete:
        missing = []
        for path in source.rglob('*'):
            if not path.is_file() or not (path.name.endswith('.rst') or path.name.endswith('.rst.inc')):
                continue
            relative = path.relative_to(source)
            if relative.parts[0] in {'_build', 'translations'}:
                continue
            if not (source / 'translations/zh_CN' / relative).is_file():
                missing.append(str(relative))
        repository_sources = subprocess.check_output(
            ['git', 'ls-files', '*.rst'], cwd=source.parent, text=True,
        ).splitlines()
        for name in repository_sources:
            if name.startswith('docs/') or name == 'tests/qapi-schema/doc-good.rst':
                continue
            if not (source / 'translations/zh_CN/_repository' / name).is_file():
                missing.append(name)
        if missing:
            parser.error('Missing Chinese articles:\n' + '\n'.join(sorted(missing)))
    environment = dict(os.environ, QEMU_DOCS_ZH='1')
    common = [sys.executable, '-m', 'sphinx', '-E', '-W', '--keep-going', '-j', args.jobs]
    subprocess.run(
        [*common, '-b', 'dummy', '-D', 'language=en', '-d', str(output / 'reference-doctrees'),
         str(source), str(output / 'reference')], cwd=source, env=environment, check=True,
    )
    subprocess.run(
        [*common, '-b', 'html', '-D', 'language=zh_CN',
         '-D', f'qemu_require_translations={int(not args.allow_incomplete)}',
         '-d', str(output / 'doctrees'), str(source), str(output / 'html')],
        cwd=source, env=environment, check=True,
    )
    validate_links(output / 'html')
    (output / 'html/.nojekyll').touch()


if __name__ == '__main__':
    main()
